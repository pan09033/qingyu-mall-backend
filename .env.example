DB_USER=mall_user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qingyu_mall

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_PROTOCOL=2

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=product-media
MINIO_SECURE=false

APP_ENV=development
LOG_LEVEL=INFO
SQL_ECHO=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PAYMENT_CALLBACK_SECRET=replace-with-another-long-random-secret

# Pydantic Settings 使用 JSON 解析列表类型环境变量。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
