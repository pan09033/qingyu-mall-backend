# 将此模板复制为 .env.docker；实际密码和 API Key 只保存在虚拟机。
HOST_BIND_IP=192.168.68.22
DB_USER=mall_user
DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=qingyu_mall

RAG_DB_HOST=pgvector
RAG_DB_PORT=5432
RAG_DB_NAME=mall_rag
RAG_DB_USER=mall_rag_app
RAG_DB_PASSWORD=replace-with-random-password
RAG_DB_CONNECT_TIMEOUT_SECONDS=3
RAG_EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
BGE_MODEL_HOST_PATH=/home/pan/models/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=512
RAG_EMBEDDING_DEVICE=cpu
RAG_MINIMUM_SIMILARITY=0.50
RAG_RETRIEVAL_LIMIT=5

DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=512

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-password
REDIS_PROTOCOL=2

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mall_queue
RABBITMQ_PASSWORD=replace-with-random-password

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_BASE_URL=http://192.168.68.22:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-random-password
MINIO_BUCKET=product-media
MINIO_SECURE=false

APP_ENV=production
LOG_LEVEL=INFO
SQL_ECHO=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
PAYMENT_CALLBACK_SECRET=replace-with-different-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://192.168.68.22:8088"]
